// Project-specific Zed settings for this AVR project.
// Compiler flags for the editor live in .clangd (generated by `task clangd` from Taskfile.yml).
{
  // Open .h files as C (Zed's default is C++), so syntax and clangd agree with avr-gcc
  "file_types": {
    "C": ["h"]
  },

  // Format C on save through clangd, which reads the style from .clang-format
  "languages": {
    "C": {
      "format_on_save": "on",
      "formatter": "language_server"
    }
  }
}
